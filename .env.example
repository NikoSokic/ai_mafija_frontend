# Bazni URL backenda (REST na /api, SockJS/STOMP na /ws), bez kose crte na kraju.
# Lokalno:    http://localhost:8080
# Produkcija: URL s Rendera, npr. https://ai-mafija-backend.onrender.com
VITE_API_URL=http://localhost:8080

# Sentry (praćenje grešaka). Prazno = isključeno. DSN je javan, smije biti u builda.
# Za čitljive greške na Vercelu još postavi SENTRY_AUTH_TOKEN, SENTRY_ORG i SENTRY_PROJECT.
VITE_SENTRY_DSN=
